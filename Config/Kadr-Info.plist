<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	    The kadr:// URL scheme (docs/03 §8.4). Xcode's INFOPLIST_KEY_ build settings
	    cannot express an array of dictionaries, so this partial plist supplies it and
	    the generator fills in everything else (LSUIElement, versions, usage strings).

	    Viewer, not Editor: Kadr answers URLs, it does not claim to own a document type.
	-->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>app.kadr.Kadr.url</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>kadr</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
