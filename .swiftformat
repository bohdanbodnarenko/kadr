# Kadr — SwiftFormat configuration
--swiftversion 6.0
--maxwidth 120
--indent 4
--tabwidth 4
--semicolons never
--commas inline
--trimwhitespace always
--stripunusedargs closure-only
--wraparguments before-first
--wrapparameters before-first
--wrapcollections before-first
--closingparen balanced
--self remove
# os.Logger messages are autoclosures, so a property reference inside one needs an
# explicit `self.`. Without this, SwiftFormat strips it and the build stops compiling.
--selfrequired log,trace,debug,info,notice,warning,error,fault,critical,beginInterval,endInterval,emitEvent
--importgrouping testable-bottom
--header ignore

--exclude .build,build,DerivedData,docs,**/.build
